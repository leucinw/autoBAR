#!/usr/bin/bash

#==== SETUP TINKER8 ====
export   TINKER8=/home/liuchw/bin/TinkerGPU2022/
export  DYNAMIC8="$TINKER8/dynamic"
export  ANALYZE8="$TINKER8/analyze"
export      BAR8="$TINKER8/bar"
export MINIMIZE8="$TINKER8/minimize"

#==== SETUP TINKER9 ====
# Keep this section in sync with autoFF/autoff/data/tinker.env and ~/.tinker.env.
#
# Two builds of Tinker9 2403 sit side by side under the same source tree:
#   build       CUDA 11.2 + OpenACC, cubins for cc 60,70,75,80
#   build_cu12  CUDA 12.9, CUDA-only (no OpenACC), cubins for cc 120
# Neither one covers both card generations. Blackwell consumer cards
# (RTX 5080/5090, cc 12.0) abort in the old build with "The source code should
# be updated for compute capability 120" -- its GPU table stopped at cc 90 --
# and CUDA 11.2 cannot emit sm_120 in any case; conversely build_cu12 carries
# sm_120 cubins that pre-Blackwell cards cannot load.
#
# Select on the card's compute capability rather than the hostname: the number
# belongs to the GPU, so it stays right when cards move between nodes or a new
# Blackwell node appears. Hostname is only the last-resort fallback.
_tk9root=/home/liuchw/Softwares/tinkers/Tinker9/2403

# "12.0" -> 120, "8.9" -> 89; empty if nvidia-smi is absent or predates the
# compute_cap query field (driver < 465), which we then work around by name.
_tk9cc=`nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' .'`
case "$_tk9cc" in
  ""|*[!0-9]*)
    _tk9cc=""
    case "`nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1`" in
      *"RTX 50"*) _tk9cc=120 ;;
    esac ;;
esac
if [ -z "$_tk9cc" ]; then
  case "`hostname -s`" in
    node138|node139) _tk9cc=120 ;;
  esac
fi

# >= 120 rather than = 120 so a later Blackwell/Rubin card still lands on the
# newer build, where its compute_120 PTX can be JIT-compiled.
if [ "${_tk9cc:-0}" -ge 120 ]; then
  export tk9home=$_tk9root/build_cu12
else
  export tk9home=$_tk9root/build
fi
export  DYNAMIC9="$tk9home/dynamic9"
export  ANALYZE9="$tk9home/analyze9"
export      BAR9="$tk9home/bar9"
export MINIMIZE9="$tk9home/minimize9"
export TESTGRAD9="$tk9home/testgrad9"

if [ "$tk9home" = "$_tk9root/build_cu12" ]; then
  #==== CUDA 12 RUNTIME ====
  # build_cu12 links cudart statically but still needs libcufft.so.11,
  # libcublas.so.12 and libcublasLt.so.12 at run time. node138 and node139 both
  # register a CUDA 12 directory with ldconfig, so this is usually redundant;
  # prepend it explicitly for nodes that do not. cuda-13.x is deliberately not
  # matched -- it ships libcufft.so.12 and cannot satisfy these sonames. The
  # 12.9 tree the build was compiled against is preferred over any other 12.x.
  for _tk9dir in /usr/local/cuda-12.9/lib64 /usr/local/cuda-12.*/lib64; do
    if [ -e "$_tk9dir/libcufft.so.11" ]; then
      export LD_LIBRARY_PATH="$_tk9dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      break
    fi
  done
  unset _tk9dir
else
  #==== CUDA 11 RUNTIME FALLBACK ====
  # The CUDA 11.2 build is linked against the CUDA 11 runtime
  # (libcudart.so.11.0, libcublas.so.11, libcublasLt.so.11, libcufft.so.10).
  # Most nodes carry a local /usr/local/cuda-11.x that provides these. node137
  # was reinstalled with CUDA 12.9 only, so the binaries failed to load there
  # with "libcufft.so.10: cannot open shared object file" -- which is why it
  # sat commented out in nodes.dat. Its driver (580.126.20) still runs CUDA 11
  # binaries fine, so only the userspace libraries were missing.
  #
  # The CUDA 11 runtime we need already ships inside the shared NVIDIA HPC SDK,
  # so point at that rather than keeping a second copy of the same libraries.
  # These are the very libraries the older Tinker9 2209 build resolves against,
  # which is why that build always ran on node137. cufft/cublas/cublasLt live
  # under math_libs, cudart under cuda -- both directories are needed.
  #
  # Applied ONLY on nodes with no local CUDA 11 runtime, so nodes that have one
  # keep using it and nothing changes for them. Verified 2026-08-12: node137
  # runs dynamic9 at 80.4 ns/day on a 2319-atom box (fastest node measured;
  # node160 31.9, bme-neptune GPU1 47.8).
  if ! ls /usr/local/cuda-11.*/lib64/libcufft.so.10 >/dev/null 2>&1; then
    _tk9sdk=/home/liuchw/shared/nvidia/hpc_sdk/Linux_x86_64/21.1
    export LD_LIBRARY_PATH="$_tk9sdk/math_libs/11.2/lib64:$_tk9sdk/cuda/11.2/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    unset _tk9sdk
  fi
fi
unset _tk9root _tk9cc
